{
  "name": "moneyprinterturbo",
  "version": "2.0.0",
  "private": true,
  "description": "Generate short videos from prompts, local assets, subtitles, and TTS.",
  "license": "MIT",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --cwd server dev",
    "dev:web": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "start": "bun run --cwd server start",
    "cli": "bun run --cwd server cli",
    "test": "bun run --cwd server test",
    "typecheck": "bun run --cwd server typecheck && bun run --cwd web typecheck"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
