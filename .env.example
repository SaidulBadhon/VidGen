# Copy to .env and adjust. Every value here has a working default, so an empty
# .env is fine for a local run with `docker compose up`.

# --- Server -----------------------------------------------------------------
LISTEN_HOST=0.0.0.0
# Used by `bun run start` and Docker. `bun run dev` binds the API to 7778
# and Vite to 7777 regardless of this value.
LISTEN_PORT=8080
LOG_LEVEL=INFO

# Public base URL used to build absolute media links in API responses.
# Leave empty to return root-relative paths such as /tasks/<id>/final-1.mp4.
ENDPOINT=

# Comma-separated list, or empty for "*".
CORS_ALLOWED_ORIGINS=

# --- MongoDB ----------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vidgen

# --- External binaries ------------------------------------------------------
# Leave empty to use whatever is on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# whisper.cpp CLI, used for subtitle transcription when subtitle_provider=whisper
WHISPER_CPP_PATH=
# tesseract CLI, used to read scanned book pages when ocr_provider=tesseract.
# The `tesseract_path` setting wins over this when it is set.
TESSERACT_PATH=

# --- LLM provider keys ------------------------------------------------------
# Set the key for whichever provider `llm_provider` selects in Settings. A key
# set here wins over one saved through the web UI, and the UI shows the field
# read-only so the two cannot disagree. Leave a line empty to fall back to the
# stored value.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Gemma is served by Ollama and normally needs no key.
GEMMA_API_KEY=

# --- Video material keys ----------------------------------------------------
# Comma-separate several keys to rotate between them on rate limits.
# The plural names are equivalent: PEXELS_API_KEY also works.
PEXELS_API_KEYS=
PIXABAY_API_KEYS=
COVERR_API_KEYS=
# Optional, for semantic reranking of search results.
TWELVELABS_API_KEYS=

# --- YouTube Data API (optional) --------------------------------------------
# Create an OAuth 2.0 Web client in Google Cloud Console, enable YouTube Data
# API v3, and add the redirect URI shown in Settings → YouTube. The Client ID
# and Secret can also be pasted in the UI; a value set here wins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to {page origin}/api/v1/youtube/oauth/callback.
# Set this when the public URL Google should call differs from the browser origin.
GOOGLE_REDIRECT_URI=
